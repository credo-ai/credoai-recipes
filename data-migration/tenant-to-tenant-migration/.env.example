# Source tenant: read only. The kit never writes to it.
SOURCE_BASE_URL=https://api.credo.ai
SOURCE_TENANT=
SOURCE_API_KEY=

# Target tenant: written to only when a load command is run with --live.
TARGET_BASE_URL=https://api.credo.ai
TARGET_TENANT=
TARGET_API_KEY=

# Set to false only for self-signed certificates.
VERIFY_SSL=true

# Optional. Comma-separated email domains. Users outside USER_EMAIL_DOMAINS (when set), or inside
# SKIP_USER_EMAIL_DOMAINS, are left out of the users extract.
USER_EMAIL_DOMAINS=
SKIP_USER_EMAIL_DOMAINS=
