# Local environment overrides for credoai-recipes.
#
# Copy this file to `.local.env` and fill in whatever the recipe you are running
# needs. mise loads `.env` and `.local.env` automatically (see `mise.toml`), and
# both are gitignored.
#
#   cp example.env .local.env
#
# Most recipes need nothing here. Only uncomment what you actually use, and never
# commit real credentials -- `detect-secrets` runs on every commit and will block
# them.

# Credo AI platform
# CREDOAI_API_KEY=
# CREDOAI_TENANT=
# CREDOAI_API_URL=https://api.credo.ai

# Model providers
# ANTHROPIC_API_KEY=
