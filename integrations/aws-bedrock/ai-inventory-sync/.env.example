# ---- Credo AI -------------------------------------------------------------
# Governance App → Settings → Integrations.
CREDO_API_KEY=your-api-key-here
# Your organization's tenant identifier.
CREDO_TENANT=your-tenant-name
# Integration Service host. The sync appends /api/v1/integration itself.
CREDO_API_BASE_URL=https://api.credo.ai

# ---- AWS ------------------------------------------------------------------
# There is deliberately no AWS key here. Credentials come from boto3's default
# chain, so point it at AWS the normal way and this just works:
#
#   laptop            aws configure / aws sso login, or AWS_PROFILE=...
#   EC2 / ECS / EKS   attach an instance, task or IRSA role — no config at all
#   CI                whatever your runner already exports
#
# Required IAM, all read-only:
#   bedrock:ListFoundationModels
#   bedrock:ListCustomModels
#   bedrock:ListImportedModels
#   bedrock:ListInferenceProfiles
#   bedrock-agentcore:ListHarnesses
#   bedrock-agentcore:GetHarness
#
# Note the bedrock-agentcore: prefix on the last two — AgentCore is a separate
# service with its own IAM signing name, so bedrock:* does NOT cover it. That
# is the single most common setup mistake: models sync fine, agents all fail.
#
# Bedrock inventory is per-region: a custom model created in one region does
# not exist in another. Governing several regions means one scheduled run per
# region, all writing into the same Credo AI tenant.
#
# Leave blank to let boto3 resolve it, which reads AWS_DEFAULT_REGION — NOT
# AWS_REGION. An environment that exports only AWS_REGION fails with
# NoRegionError, which is why this setting exists.
BEDROCK_REGION=us-east-1

# ---- What to sync ---------------------------------------------------------
# Your own custom (fine-tuned) and imported models are always synced; no
# setting affects them.
#
# Foundation models are the region-wide catalog AWS publishes — 100+ records
# covering every provider available in the region, whether or not you use them.
# false (the default) syncs only the base models one of your agents actually
# names, so the registry holds the models in use and every agent-to-model link
# resolves. true syncs the whole catalog.
#
# There is no "off": skipping foundation models entirely would leave your
# agents linked to models that aren't in the registry.
BEDROCK_SYNC_ALL_FOUNDATION_MODELS=false

# AgentCore agents, synced as Credo AI Use Cases — one per harness. Set false
# for an account or region that doesn't use AgentCore, where the listing would
# otherwise fail every run and exit non-zero.
BEDROCK_SYNC_AGENTCORE=true

LOG_LEVEL=INFO
