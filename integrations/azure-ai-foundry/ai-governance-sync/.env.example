# ---- Credo AI -------------------------------------------------------------
# API token, created on the Credo AI Platform: https://app.credo.ai/my-settings/tokens/
CREDO_API_TOKEN=your-api-token-here
# Your organization's tenant identifier (used to log in to the Credo AI Platform).
CREDO_TENANT=your-tenant-name
# The sync appends /api/v2/{tenant}/... itself.
CREDO_BASE_PATH=https://api.credo.ai

# ---- Azure AD app registration ---------------------------------------------
# Entra ID -> App registrations -> New registration -> Overview page.
AZURE_TENANT_ID=your-azure-ad-tenant-id
# Application (client) ID from the same Overview page.
AZURE_APP_CLIENT_ID=your-azure-app-client-id
# Certificates & secrets -> New client secret -> copy the Value (shown once).
AZURE_CLIENT_SECRET=your-azure-client-secret
#
# No Azure RBAC role assignment is required beyond the app registration itself — the model
# catalog call this cookbook makes is public catalog metadata, not your own AI Foundry project
# data, so a valid Azure AD bearer token is all it needs.

# ---- What to sync -----------------------------------------------------------
# Each domain can be switched off independently, e.g. for a tenant that already runs its own
# questionnaire and only wants models + controls synced from here.
SYNC_MODELS=true
SYNC_CONTROLS=true
SYNC_CUSTOM_FIELDS=true
SYNC_QUESTIONNAIRE=true

# "1" creates a fresh DEFAULT_AZURE questionnaire from the Azure template alone.
# "2" fetches your tenant's existing questionnaire (CREDO_QUESTIONNAIRE_ID + _VERSION below) and
# merges its sections with the Azure template, instead of replacing it.
CREDO_QUESTIONNAIRE_OPTIONS=1
# Only required if CREDO_QUESTIONNAIRE_OPTIONS=2.
CREDO_QUESTIONNAIRE_ID=
CREDO_QUESTIONNAIRE_VERSION=

LOG_LEVEL=INFO
