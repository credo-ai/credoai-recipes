# ---- Credo AI ---------------------------------------------------------
CREDO_API_KEY=your-api-key-here
CREDO_TENANT=your-tenant-name
# Integration Service — the public API this bridge uses for every model
# create/update, and to exchange CREDO_API_KEY for a bearer token
# (/auth/token).
CREDO_BASE_URL=https://your-tenant.credo.ai/api/v1/integration
# Backend host, used by setup_credo_source.py ONLY. Creating the "Databricks"
# source is a one-time admin operation on the private v2 API, which lives on
# a different host than CREDO_BASE_URL. The bridge itself never calls this.
# Ask your Credo AI representative for the URL. See README.md Step 2.
CREDO_BACKEND_BASE_URL=https://your-tenant.credo.ai

# ---- Databricks -------------------------------------------------------
# Read directly by the Databricks SDK's unified auth. Host includes the
# scheme, e.g. https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-pat-here
# Optional: scope the webhook to a single registered model. Leave blank for
# a registry-wide webhook. Note that REGISTERED_MODEL_CREATED is only
# delivered to registry-wide webhooks, so setting this means new models with
# no versions yet won't sync until their first version lands.
DATABRICKS_MODEL_NAME=
# Shared secret for X-Databricks-Signature. Required: main.py refuses to start
# without it, since an unsigned endpoint would let anyone create or overwrite
# Credo AI models.
DATABRICKS_WEBHOOK_SECRET=
# Local curl testing only: set to true to start without a secret and skip
# signature verification. Never for an endpoint reachable from the internet.
ALLOW_UNSIGNED_WEBHOOKS=

# ---- Server -----------------------------------------------------------
# Public HTTPS base URL where Databricks can reach this server — your tunnel
# or ingress, no trailing slash. Used by register_webhook.py to build the
# webhook target. Free ngrok URLs rotate on every restart; re-run
# `register_webhook.py register` when yours changes.
PUBLIC_BASE_URL=https://your-tunnel-here.ngrok-free.dev
PORT=5000
LOG_LEVEL=INFO
