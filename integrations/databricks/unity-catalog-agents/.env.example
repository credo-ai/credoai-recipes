# ---- Credo AI ---------------------------------------------------------
CREDO_API_KEY=your-api-key-here
CREDO_TENANT=your-tenant-name
# Integration Service -- the public API this poller uses for every use case
# create/update, and to exchange CREDO_API_KEY for a bearer token
# (/auth/token). The tenant goes in CREDO_TENANT, never in the URL. Unlike the
# other cookbooks, the /api/v1/integration path is part of this value.
CREDO_BASE_URL=https://api.credo.ai/api/v1/integration
# Backend host for the private v2 API. Used by setup_credo_source.py (creating
# the "Databricks" source is a one-time admin operation) and by the poller to
# sync Genie agents as Credo AI Agent entities, which the public Integration
# API cannot create yet. It is the same host as above, without the path. If
# unset, Genie agents are skipped and deployed agents still sync.
CREDO_BACKEND_BASE_URL=https://api.credo.ai

# ---- Databricks -------------------------------------------------------
# Read directly by the Databricks SDK's unified auth. Host includes the
# scheme, e.g. https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-pat-here
# Optional: restrict the sync to one catalog, or to one schema within it. Leave
# both blank to sync every agent deployed in the workspace. The deployment list
# is workspace-wide and filtered here, so a catalog on its own is valid. A
# schema needs the catalog.
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# ---- Poller tuning ----------------------------------------------------
# How often to poll, in seconds. Every cycle re-reads every deployed agent
# (two Unity Catalog calls each -- the deployment list has no change
# timestamp), and UC enforces a per-account rate limit
# (REQUEST_LIMIT_EXCEEDED). Lower this only if you have few agents.
POLL_INTERVAL_SECONDS=300
# Pause between per-agent Unity Catalog calls, in seconds. Keeps a large
# number of agents under the UC rate limit.
REQUEST_DELAY_SECONDS=0.1
LOG_LEVEL=INFO
