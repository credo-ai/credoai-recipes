# ---- Credo AI ---------------------------------------------------------
CREDO_API_KEY=your-api-key-here
CREDO_TENANT=your-tenant-name
# Integration Service -- the public API this poller uses for every model
# create/update, and to exchange CREDO_API_KEY for a bearer token
# (/auth/token). The tenant goes in CREDO_TENANT, never in the URL. Unlike the
# other cookbooks, the /api/v1/integration path is part of this value.
CREDO_BASE_URL=https://api.credo.ai/api/v1/integration
# Backend host, used by setup_credo_source.py ONLY. Creating the "Databricks"
# source is a one-time admin operation on the private v2 API. It is the same
# host as above, without the path. The poller itself never calls this.
# See README.md Step 2.
CREDO_BACKEND_BASE_URL=https://api.credo.ai

# ---- Databricks -------------------------------------------------------
# Read directly by the Databricks SDK's unified auth. Host includes the
# scheme, e.g. https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-pat-here
# Optional: restrict the sync to a single schema. Leave BOTH blank to sync
# the whole metastore (minus the `system` and `__databricks_internal`
# catalogs, which hold Databricks' own built-in foundation models -- on a
# stock workspace that is 94 of 96 registered models).
# Unity Catalog rejects a catalog without a schema, so these are set together
# or not at all. There is no way to scope to an entire catalog in one call.
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# ---- Poller tuning ----------------------------------------------------
# How often to poll Unity Catalog, in seconds. Higher than you might expect:
# each changed model costs two UC calls, and UC enforces a per-account rate
# limit (REQUEST_LIMIT_EXCEEDED). Lower this only if your metastore is small.
POLL_INTERVAL_SECONDS=300
# Every Nth cycle ignores the change watermark and re-syncs every model.
# Creating a version, setting an alias, and editing model-level metadata were
# observed to bump a registered model's `updated_at`, so the watermark catches
# them on the next cycle. Databricks does not document this. Editing a
# *version's* comment was observed NOT to bump the parent -- this sweep is what
# eventually picks that up. Set to 1 to sweep every cycle.
FULL_SWEEP_EVERY_N_CYCLES=20
# Pause between per-model Unity Catalog calls, in seconds. Keeps a full sweep
# of a large metastore under the UC rate limit.
REQUEST_DELAY_SECONDS=0.1
LOG_LEVEL=INFO
