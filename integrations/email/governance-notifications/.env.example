# Copy to .env (cp .env.example .env), fill in, then: chmod 600 .env
# .env holds your API key and the webhook token. It is gitignored; keep it that way.

# ---- Credo AI -------------------------------------------------------------
# Governance App → Settings → Integrations. Use a dedicated service user; this
# cookbook only reads models.
CREDO_API_KEY=your-api-key-here
# Your organization's tenant identifier.
CREDO_TENANT=your-tenant-name
# Integration Service host. The SDK appends /api/v1/integration itself.
CREDO_API_BASE_URL=https://api.credo.ai
# The Credo AI web app, used for the "View model" link in emails.
CREDO_APP_BASE_URL=https://app.credo.ai

# ---- Webhook endpoint -----------------------------------------------------
# The secret part of your webhook URL: https://<your-host>/webhook/<token>.
# Generate it with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# At least 32 characters, or the server won't start.
WEBHOOK_PATH_TOKEN=paste-the-generated-token-here

# Comma-separated. Emails only ever go to addresses in these domains.
ALLOWED_EMAIL_DOMAINS=example.com

# ---- Email ----------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (local test servers only)
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Credo AI Notifications <credo-notifications@example.com>
# Seconds between sends. 0 for a real provider; 1.2 for Mailtrap's free sandbox.
SMTP_MIN_INTERVAL_SECONDS=0
# true = write each email to the log instead of sending it.
MAIL_DRY_RUN=false

# ---- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# On the first start, treat every existing model as already emailed (README
# "Why existing models are skipped"). Leave this on.
SEED_EXISTING_MODELS=true
LOG_LEVEL=INFO
