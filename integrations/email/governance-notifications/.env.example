# Copy to .env (cp .env.example .env), fill in the Credo AI and email settings,
# then run setup_webhook.py, which fills in the webhook settings. chmod 600 .env
# .env holds your API key, the webhook token and its signing secret. It is
# gitignored; keep it that way.

# ---- Credo AI -------------------------------------------------------------
# Governance App → Settings → Integrations. Use a dedicated service user with
# the admin role (README "API key permissions").
CREDO_API_KEY=your-api-key-here
# Your organization's tenant identifier.
CREDO_TENANT=your-tenant-name
# Integration Service host. The SDK appends /api/v1/integration itself.
CREDO_API_BASE_URL=https://api.credo.ai
# The Credo AI web app, used for the links in emails.
CREDO_APP_BASE_URL=https://app.credo.ai
# Seconds an owner, admin or user lookup is reused.
RECIPIENT_CACHE_SECONDS=300

# ---- Webhook endpoint (written by setup_webhook.py) ------------------------
# The secret part of your webhook URL: https://<your-host>/webhook/<token>.
WEBHOOK_PATH_TOKEN=run-setup-webhook
# The webhook's signing secret (whsec_...). Every delivery is checked against
# it. Also shown in Settings → Webhooks → Signing secret.
WEBHOOK_SIGNING_SECRET=run-setup-webhook
# The webhook setup_webhook.py created, for reference.
CREDO_WEBHOOK_ID=

# ---- Email ----------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (local test servers only)
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Credo AI Notifications <credo-notifications@example.com>
# Seconds between sends. 0 for a real provider; 1.2 for Mailtrap's free sandbox.
SMTP_MIN_INTERVAL_SECONDS=0
# true = write each email to the log instead of sending it.
MAIL_DRY_RUN=false

# ---- Reminders (#6 pending controls, #8 questionnaires due) ----------------
# false = don't schedule them in the server; run remind.py from your own cron.
REMINDERS_IN_PROCESS=true
# IANA timezone for the cron expressions and the dates in reminder emails.
REMINDER_TIMEZONE=UTC
# 5-field cron expressions, in REMINDER_TIMEZONE.
PENDING_CONTROLS_CRON=0 9 * * mon
QUESTIONNAIRE_REMINDER_CRON=0 9 * * *
# Remind about a questionnaire once it is due within this many days, or overdue.
QUESTIONNAIRE_DUE_WITHIN_DAYS=7

# ---- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
