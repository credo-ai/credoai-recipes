{% extends "_layout.html.j2" %}
{% block eyebrow %}Questionnaire answer changed{% endblock %}
{% block heading %}{{ entity.name }}{% endblock %}
{% block body %}
                <p style="margin:0 0 16px 0;font-size:14px;line-height:1.6;">
                  An answer on one of this {{ entity.entity_type | replace("_", " ") }}'s questionnaires was changed.
                  {% if role == "reviewer" %}You're a reviewer on its open review.{% else %}You're receiving this as a
                  Credo AI admin.{% endif %}
                </p>
{% endblock %}
{% block button %}View questionnaires{% endblock %}
