<!doctype html>
<html lang="en">
  <body style="margin:0;padding:24px;background:#f8f8fa;font-family:Arial,Helvetica,sans-serif;color:#363644;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0"
                 style="max-width:560px;width:100%;background:#ffffff;border:1px solid #ebebf2;border-radius:12px;">
            <tr>
              <td style="padding:28px;">
                <p style="margin:0 0 16px 0;font-size:14px;color:#7c03ca;font-weight:bold;">New model added</p>
                <h1 style="margin:0 0 8px 0;font-size:22px;line-height:1.3;">{{ model.name }}</h1>
                <p style="margin:0 0 16px 0;font-size:13px;color:#757582;">Status: {{ model.status }}</p>
                {% if model.summary %}
                <p style="margin:0 0 16px 0;font-size:14px;line-height:1.6;">{{ model.summary }}</p>
                {% endif %}
                <p style="margin:0 0 24px 0;font-size:14px;line-height:1.6;">
                  Next steps: link the model to the use cases that rely on it, and complete any
                  questionnaires attached to it.
                </p>
                <a href="{{ link }}"
                   style="display:inline-block;padding:12px 24px;background:#7c03ca;color:#ffffff;
                          text-decoration:none;border-radius:8px;font-size:14px;font-weight:bold;">View model</a>
              </td>
            </tr>
          </table>
          <p style="margin:16px 0 0 0;font-size:12px;color:#9999a4;">
            Sent by your organization's Credo AI notification service.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
