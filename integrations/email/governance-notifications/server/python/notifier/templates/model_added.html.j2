{% extends "_layout.html.j2" %}
{% block eyebrow %}New model added{% endblock %}
{% block heading %}{{ model.name }}{% endblock %}
{% block body %}
                {% if model.status and model.status != "none" %}
                <p style="margin:0 0 16px 0;font-size:13px;color:#757582;">Status: {{ model.status }}</p>
                {% endif %}
                {% if model.summary %}
                <p style="margin:0 0 16px 0;font-size:14px;line-height:1.6;">{{ model.summary }}</p>
                {% endif %}
                <p style="margin:0 0 16px 0;font-size:14px;line-height:1.6;">
                  You added this model to your organization's model registry. Next steps: link it to the
                  use cases that rely on it, and complete any questionnaires attached to it.
                </p>
{% endblock %}
{% block button %}View model{% endblock %}
