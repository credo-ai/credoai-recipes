{% extends "_layout.html.j2" %}
{% block eyebrow %}Weekly summary{% endblock %}
{% block heading %}{{ items | length }} control{{ "s" if items | length != 1 }} waiting on your use cases{% endblock %}
{% block body %}
                {% if overdue %}
                <p style="margin:0 0 16px 0;font-size:14px;line-height:1.6;color:#c4320a;">{{ overdue }} overdue.</p>
                {% endif %}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;line-height:1.5;">
                  <tr style="color:#757582;text-align:left;">
                    <th style="padding:6px 8px 6px 0;">Use case</th><th style="padding:6px 8px;">Control</th>
                    <th style="padding:6px 8px;">State</th><th style="padding:6px 0 6px 8px;">Due</th>
                  </tr>
                  {% for item in items %}
                  <tr style="border-top:1px solid #ebebf2;">
                    <td style="padding:6px 8px 6px 0;">{{ item.use_case }}</td>
                    <td style="padding:6px 8px;"><a href="{{ item.link }}" style="color:#7c03ca;">{{ item.control }}</a></td>
                    <td style="padding:6px 8px;">{{ item.state }}</td>
                    <td style="padding:6px 0 6px 8px;{% if item.overdue %}color:#c4320a;{% endif %}">{{ item.due or "—" }}</td>
                  </tr>
                  {% endfor %}
                </table>
{% endblock %}
