# ---- Credo AI ---------------------------------------------------------------
# API key, created on the Credo AI Platform: https://app.credo.ai/my-settings/tokens/
CREDOAI_API_KEY=your-api-key-here
# Your organization's tenant identifier (used to log in to the Credo AI Platform).
CREDOAI_TENANT=your-tenant-name
# Used for both the public Integration API (use case create/delete, via the pycredoai SDK) and the
# private API (webhook registration — see github_gate/credo_private.py).
CREDOAI_API_URL=https://api.credo.ai
#
# Only set this if your private API (/auth/exchange, /api/v2/...) lives on a DIFFERENT host
# than CREDOAI_API_URL above — true only for some local dev setups.
# CREDOAI_PRIVATE_API_URL=http://localhost:4000

# ---- GitHub -----------------------------------------------------------------
# Token that can write commit statuses on your repo.
# Classic PAT: `repo:status` scope. Fine-grained PAT: "Commit statuses: write".
GITHUB_TOKEN=your-github-token-here

# ---- Gate service -----------------------------------------------------------
# Public HTTPS URL of this service. Credo AI calls {GATE_PUBLIC_BASE_URL}/webhooks/credo, and your
# GitHub workflow calls {GATE_PUBLIC_BASE_URL}/gate/notify. For local testing, run a tunnel
# (e.g. `ngrok http 8321`) and paste its https URL here.
GATE_PUBLIC_BASE_URL=https://your-gate-service.example.com
# Local bind address and port (the port must match your tunnel's target).
GATE_HOST=127.0.0.1
GATE_PORT=8321
# Optional. When set, POST /gate/notify requires a matching X-Gate-Secret header — set the same
# value as the GATE_SHARED_SECRET secret in your GitHub repo.
GATE_SHARED_SECRET=

LOG_LEVEL=INFO
