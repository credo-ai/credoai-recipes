# ---- Credo AI -------------------------------------------------------------
# Governance App → Settings → Integrations.
CREDO_API_KEY=your-api-key-here
# Your organization's tenant identifier.
CREDO_TENANT=your-tenant-name
# Integration Service host. The sync appends /api/v1/integration itself.
CREDO_API_BASE_URL=https://api.credo.ai

# Optional. A questionnaire to attach to every agent's Use Case, written
# "<key>+<version>" — the id shown for it in the Governance App. Leave blank to
# attach nothing. The questionnaire must already exist in your tenant.
CREDO_INTAKE_QUESTIONNAIRE=

# ---- Microsoft Entra app registration --------------------------------------
# One app registration does both jobs — see README Step 2.
#   Directory (tenant) ID, Application (client) ID, and a client secret VALUE
#   (not the secret's ID).
MS_TENANT_ID=your-entra-tenant-id
MS_CLIENT_ID=your-entra-app-client-id
# Used only to READ the catalog, app-only, so a scheduled run needs no human.
# Blocking and unblocking cannot use it — Microsoft rejects an app-only token
# for those two calls — so --enforce uses a signed-in admin instead
# (python main.py --login), and never reads this secret.
MS_CLIENT_SECRET=your-entra-app-client-secret

# ---- What to sync ----------------------------------------------------------
# The catalog also lists every Microsoft and third-party app — hundreds of
# records your organization never built. The default syncs only agents your own
# people built or uploaded:
#   shared      built in Copilot Studio, Agent Builder or Foundry and shared
#   lob         a line-of-business app uploaded by your admins
#   firstparty  Microsoft's own
#   thirdparty  Microsoft Store / AppSource apps
# A comma-separated list, or `all`.
AGENT365_PACKAGE_TYPES=shared,lob

# Where --login saves the admin's refresh token, which is standing access to the
# Copilot catalog. Blank = .agent365_token.json at the cookbook root (gitignored,
# owner-only). Entra rotates this token on every use, so on a scheduled
# --enforce run the file must survive between runs.
AGENT365_TOKEN_CACHE=

LOG_LEVEL=INFO
