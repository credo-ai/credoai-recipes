# ---- Credo AI ---------------------------------------------------------
CREDO_API_KEY=your-api-key-here
CREDO_TENANT=your-tenant-name
# Integration Service — used only to exchange CREDO_API_KEY for a bearer
# token (/auth/token).
CREDO_BASE_URL=https://your-tenant.credo.ai/api/v1/integration
# Backend host for the Shadow AI bulk endpoint — Shadow AI Discovery is
# Research Preview and has no public Integration Service endpoint yet, so
# this cookbook calls the backend directly. Ask your Credo AI representative
# for this URL. Not the same host as CREDO_BASE_URL. See README.md.
CREDO_BACKEND_BASE_URL=https://your-tenant.credo.ai

# ---- Splunk -------------------------------------------------------------
# splunkd REST management port — NOT the Splunk Web port (8000).
SPLUNK_HOST=your-splunk-host
SPLUNK_PORT=8089
# Read-only service account scoped to one index — see README Step 2.
# Never use an admin account here.
SPLUNK_USERNAME=your-splunk-service-account
SPLUNK_PASSWORD=your-splunk-service-account-password
SPLUNK_INDEX=your-index-name
SPLUNK_SOURCETYPE=your-sourcetype-name
# Set to false only for a self-signed lab/dev cert (e.g. local Docker
# Splunk). Never disable for a real customer instance.
SPLUNK_VERIFY_SSL=true

# ---- Poller tuning --------------------------------------------------------
# How often to poll Splunk, in seconds.
POLL_INTERVAL_SECONDS=60
# Events per Credo AI bulk POST.
BATCH_SIZE=200
# Where the last-seen-event-time cursor is persisted. Must survive restarts —
# don't point this at a tmpfs or an ephemeral container filesystem.
CHECKPOINT_PATH=./checkpoint.txt
LOG_LEVEL=INFO
