# Copy to .env (gitignored) and fill in. Read only by the token service in server/python/.
# The API key never reaches the browser: the web components only ever see the
# short-lived tokens this service mints from it.

# Credo AI API key and tenant (platform settings > API keys)
CREDO_API_KEY=
CREDO_TENANT=

# In production both surfaces are the same host. Set them independently only if
# your stack splits them across hosts or ports.
CREDO_PRIVATE_API_BASE_URL=https://api.credo.ai
CREDO_INTEGRATION_API_BASE_URL=https://api.credo.ai

# Browser origins allowed to call POST /api/token, comma-separated.
# Set this to your portal's origin(s) exactly. The default is the local dev pages.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
